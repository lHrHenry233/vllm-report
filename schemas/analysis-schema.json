{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Commit Analysis (SIG-based)",
  "description": "AI analysis result for a single day's vllm commits, classified by vLLM SIG",
  "type": "object",
  "required": ["date", "repo", "generated_at", "daily_summary", "commits"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date in UTC+8 (YYYY-MM-DD)"
    },
    "repo": {
      "type": "string",
      "pattern": "^.+/.+$",
      "description": "GitHub repo full name (owner/repo)"
    },
    "generated_at": {
      "type": "string",
      "description": "Timestamp when analysis was generated (ISO 8601 with timezone)"
    },
    "daily_summary": {
      "type": "string",
      "description": "Summary of the day's changes"
    },
    "sig_summaries": {
      "type": "object",
      "description": "Per-SIG summary of the day's changes, keyed by SIG id",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha", "comment", "sig", "tags"],
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Full commit SHA"
          },
          "comment": {
            "type": "string",
            "description": "AI analysis comment for this commit"
          },
          "sig": {
            "type": "string",
            "enum": [
              "sig-core",
              "sig-large-scale-serving",
              "sig-model-performance",
              "sig-spec-decode",
              "sig-ci",
              "sig-quantization",
              "sig-omni",
              "sig-rl",
              "other"
            ],
            "description": "Primary vLLM SIG this commit belongs to (per Q3 roadmap #48168)"
          },
          "sig_reason": {
            "type": "string",
            "description": "Why the commit was assigned to this SIG"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Classification tags (type, risk, module)"
          }
        }
      }
    }
  }
}
